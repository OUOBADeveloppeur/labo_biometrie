<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hf.ui.widget.EasyActionbar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/stepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 1: User Info"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- STEP 1: USER INFO -->
            <LinearLayout
                android:id="@+id/step1_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Informations Civiles"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"
                    android:textColor="#333333"/>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Nom">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUserName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                    
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Prénom">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrenom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Sexe (M/F)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSex"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Date de Naissance">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:hint="Localité">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVille"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnNextToStep2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#1E88E5"
                    android:textColor="#FFFFFF"
                    android:text="Suivant (Empreintes)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <!-- STEP 2: FINGERPRINT -->
            <LinearLayout
                android:id="@+id/step2_fingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFpHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Veuillez placer vos 4 doigts sur le lecteur."
                    android:gravity="center"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <ImageView
                    android:id="@+id/fpPreview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#eeeeee"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvFingerScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Score: N/A"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp"
                    android:padding="8dp"
                    android:background="#e8f5e9">

                    <TextView
                        android:id="@+id/tvNfiqLevelLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seuil NFIQ : 3 (Recommandé)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2e7d32"
                        android:layout_marginEnd="10dp"/>

                    <SeekBar
                        android:id="@+id/nfiqSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="4"
                        android:progress="2" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnCaptureFp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:text="Capturer Empreintes (442)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <Button
                    android:id="@+id/btnNextToStep3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#1E88E5"
                    android:textColor="#FFFFFF"
                    android:text="Continuer vers l'Iris ➔"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- STEP 3: IRIS -->
            <LinearLayout
                android:id="@+id/step3_iris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/irisHintTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Regardez le scanner d'Iris"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <FrameLayout
                    android:id="@+id/irisFragmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="#000000" />

                <Button
                    android:id="@+id/btnCaptureIris"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:text="Capturer Iris"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <Button
                    android:id="@+id/btnNextToStep4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#1E88E5"
                    android:textColor="#FFFFFF"
                    android:text="Continuer vers le Visage ➔"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- STEP 4: FACE -->
            <LinearLayout
                android:id="@+id/step4_face"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cliquez ci-dessous pour ouvrir la caméra Faciale"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnLaunchFaceCamera"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:text="Lancer la Caméra Faciale"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/tvFaceResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#00FF00"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <Button
                    android:id="@+id/btnFinishEnrollment"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="SAUVEGARDER &amp; ENVOYER 💾"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:visibility="gone"
                    android:textStyle="bold"/>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
