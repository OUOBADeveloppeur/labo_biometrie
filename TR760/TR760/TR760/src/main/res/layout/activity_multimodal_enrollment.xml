<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.hf.ui.widget.EasyActionbar
        android:id="@+id/actionbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/stepTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Step 1: User Info"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- STEP 1: USER INFO -->
            <LinearLayout
                android:id="@+id/step1_user_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <EditText
                    android:id="@+id/etUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter User Name"
                    android:minHeight="48dp" />
                    
                <EditText
                    android:id="@+id/etPrenom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Prénom"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/etSex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Sexe (M/F)"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/etAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Âge"
                    android:inputType="number"
                    android:minHeight="48dp" />

                <EditText
                    android:id="@+id/etVille"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ville"
                    android:minHeight="48dp" />

                <Button
                    android:id="@+id/btnNextToStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next (Fingerprint)"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- STEP 2: FINGERPRINT -->
            <LinearLayout
                android:id="@+id/step2_fingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFpHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Please place 4 fingers on the scanner."
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <ImageView
                    android:id="@+id/fpPreview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="#eeeeee"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:id="@+id/tvFingerScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Score: N/A"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"/>

                <Button
                    android:id="@+id/btnCaptureFp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Capture 442 Fingerprints"
                    android:layout_marginTop="16dp"/>

                <Button
                    android:id="@+id/btnNextToStep3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next (Iris)"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- STEP 3: IRIS -->
            <LinearLayout
                android:id="@+id/step3_iris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/irisHintTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Look at the Iris Scanner"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <FrameLayout
                    android:id="@+id/irisFragmentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:background="#000000" />

                <Button
                    android:id="@+id/btnCaptureIris"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Capture Iris"
                    android:layout_marginTop="16dp"/>

                <Button
                    android:id="@+id/btnNextToStep4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Next (Face)"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>

            <!-- STEP 4: FACE -->
            <LinearLayout
                android:id="@+id/step4_face"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Click below to open Face Camera"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnLaunchFaceCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Launch Face Camera"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/tvFaceResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#00FF00"
                    android:gravity="center"
                    android:layout_marginTop="16dp"/>

                <Button
                    android:id="@+id/btnFinishEnrollment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Save &amp; Finish Enrollment"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
