<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BASE_BACKGROUND">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >
        <com.hf.ui.widget.EasyActionbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:id="@+id/actionbar"/>
        <TextView
            android:id="@+id/textView_b"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:text="TextView" />

        <TextView
            android:id="@+id/textView_v"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:text="TextView" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >

                <Button
                    android:id="@+id/binaryReset"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_margin="5dp"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ripple_button2"
                    android:text="binaryReset" />

                <Button
                    android:id="@+id/readBinary"
                    android:layout_width="0dp"
                    android:layout_margin="5dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ripple_button2"
                    android:text="readBinary" />

                <Button
                    android:id="@+id/updateBinary"
                    android:layout_width="0dp"
                    android:layout_margin="5dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ripple_button2"
                    android:text="updateBinary" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/textView_s"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:textColor="@color/black"
            android:layout_weight="2"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="" />

    </LinearLayout>

</RelativeLayout>
